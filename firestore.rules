rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /global/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /sliderImages/{docId} {
      allow read, write: if true;
    }
    match /notices/{docId} {
      allow read, write: if true;
    }
    match /notifications/{docId} {
      allow read, write: if true;
    }
    match /meritPanels/{docId} {
      allow read, write: if true;
    }
    match /results/{docId} {
      allow read, write: if true;
    }
    match /darCirculars/{docId} {
      allow read, write: if true;
    }
    match /actCirculars/{docId} {
      allow read, write: if true;
    }
    match /links/{docId} {
      allow read, write: if true;
    }
    match /externalLinks/{docId} {
      allow read, write: if true;
    }
    match /internalLinks/{docId} {
      allow read, write: if true;
    }
    match /videos/{docId} {
      allow read, write: if true;
    }
    match /images/{docId} {
      allow read, write: if true;
    }
    match /documents/{docId} {
      allow read, write: if true;
    }
    match /logos/{docId} {
      allow read, write: if true;
    }
    match /contact_submissions/{docId} {
      allow read, write: if true;
    }
    match /candidate_queries/{docId} {
      allow read, write: if true;
    }
    match /issuedSFs/{docId} {
      allow read, write: if true;
    }
    match /apoWorkAllotments/{docId} {
      allow read, write: if true;
    }
    match /dynamic_registers/{docId} {
      allow read, write: if true;
    }
    match /dynamic_register_records/{docId} {
      allow read, write: if true;
    }
    match /google_sheets_sources/{docId} {
      allow read, write: if true;
    }
    match /sheet_sync_records/{docId} {
      allow read, write: if true;
    }
    match /employees/{docId} {
      allow read, write: if true;
    }
    match /attendance/{docId} {
      allow read, write: if true;
    }
    match /stipend/{docId} {
      allow read, write: if true;
    }
    match /training/{docId} {
      allow read, write: if true;
    }
    match /medical/{docId} {
      allow read, write: if true;
    }
    match /bank_details/{docId} {
      allow read, write: if true;
    }
    match /trade_details/{docId} {
      allow read, write: if true;
    }
    match /audit_logs/{docId} {
      allow read, write: if true;
    }
    match /nfrOrgNodes/{docId} {
      allow read, write: if true;
    }
    match /dar_positions/{docId} {
      allow read, write: if true;
    }
    match /pending_sf4_drafts/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
